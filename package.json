{
  "name": "rendercv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rendercv/api --filter @rendercv/web dev",
    "dev:web": "pnpm --filter @rendercv/web dev",
    "dev:api": "pnpm --filter @rendercv/api dev",
    "dev:docs": "pnpm --filter @rendercv/docs dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @rendercv/web build",
    "build:api": "pnpm --filter @rendercv/api build",
    "build:docs": "pnpm --filter @rendercv/docs build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "preview": "pnpm --filter @rendercv/web preview",
    "vendor:pyodide": "node scripts/vendor/vendor-pyodide.mjs",
    "vendor:pyodide:check": "node scripts/vendor/vendor-pyodide.mjs --check"
  }
}
